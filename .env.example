# Supabase Postgres connection string. Use the pooled "Transaction" connection
# (port 6543, Supabase dashboard: Project Settings > Database > Connection
# pooling) here for local dev and in Vercel's env vars. Running
# `prisma migrate dev`/`db:seed` needs the *direct* connection (port 5432)
# instead — pgbouncer's transaction pooling breaks Prisma's migration engine.
DATABASE_URL="postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres"
SESSION_SECRET="generate with: openssl rand -base64 32"

# Optional: set this to actually send booking confirmation emails via Resend
# (https://resend.com). Without it, email notifications are logged, not sent.
RESEND_API_KEY=
RESEND_FROM="Jugnu's Salon <bookings@yourdomain.com>"
